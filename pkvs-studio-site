<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PKVS Studio – prepare seus VS no REAPER em minutos</title>
<meta name="description" content="Ferramenta para REAPER que importa as faixas, organiza por instrumento, muda o tom, abaixa o volume e renderiza suas músicas.">
<style>
:root{
  --bg:#14161c; --painel:#1b1d25; --linha:#2c303c; --texto:#e8eaf0; --suave:#9aa1b3;
  --roxo:#8a35d9; --roxo2:#a85cf0; --ambar:#f5a623;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--texto);font:17px/1.6 "Bahnschrift","Segoe UI",system-ui,sans-serif}
a{color:inherit}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
header{display:flex;align-items:center;justify-content:space-between;padding:20px 0}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:19px;text-decoration:none}
.logo i{width:34px;height:34px;border-radius:50%;background:linear-gradient(#a53cf0,#6d22c8);border:3px solid #ecbeff;display:grid;place-items:center;font:700 12px/1 "Bahnschrift",sans-serif;font-style:normal;color:#fff}
header nav a{margin-left:22px;color:var(--suave);text-decoration:none;font-size:15px}
header nav a:hover{color:var(--texto)}
h1{font-size:clamp(34px,6vw,60px);line-height:1.05;margin:36px 0 18px;max-width:15ch;letter-spacing:-.01em}
.sub{max-width:52ch;color:var(--suave);font-size:19px;margin:0 0 28px}
.btns{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-block;padding:13px 24px;border-radius:8px;font-weight:700;text-decoration:none;border:2px solid var(--roxo);background:var(--roxo);color:#fff}
.btn:hover{background:var(--roxo2);border-color:var(--roxo2)}
.btn.vazio{background:transparent;color:var(--texto);border-color:var(--linha)}
.btn.vazio:hover{border-color:var(--suave)}
.btn[aria-disabled=true]{opacity:.5;pointer-events:none}
:focus-visible{outline:3px solid var(--ambar);outline-offset:3px}

/* a "mesa": o que o app monta no REAPER */
.mesa{margin:56px 0 24px;background:var(--painel);border:1px solid var(--linha);border-radius:10px;overflow:hidden}
.mesa-topo{display:grid;grid-template-columns:120px 1fr;border-bottom:1px solid var(--linha);font-size:13px;color:var(--suave)}
.mesa-topo div:first-child{padding:8px 12px}
.musicas{position:relative;height:34px}
.musicas span{position:absolute;top:6px;bottom:6px;border-left:2px solid var(--ambar);padding-left:8px;line-height:22px;color:var(--texto)}
.pistas{position:relative}
.pista{display:grid;grid-template-columns:120px 1fr;height:30px;border-bottom:1px solid #23262f}
.pista:last-child{border-bottom:0}
.pista b{font-weight:400;font-size:13px;color:var(--suave);padding:0 12px;display:flex;align-items:center;gap:8px;white-space:nowrap;overflow:hidden}
.pista b:before{content:"";width:8px;height:8px;border-radius:2px;background:var(--c);flex:none}
.faixa{position:relative}
.faixa i{position:absolute;top:4px;bottom:4px;border-radius:3px;background:
  repeating-linear-gradient(90deg,rgba(0,0,0,.22) 0 2px,transparent 2px 5px),var(--c);opacity:.9}
.cabeca{position:absolute;top:0;bottom:0;left:120px;width:2px;background:#fff;box-shadow:0 0 8px #fff8;animation:tocar 16s linear infinite}
@keyframes tocar{from{transform:translateX(0)}to{transform:translateX(calc(var(--larg) - 2px))}}
.legenda{color:var(--suave);font-size:14px;margin:0 0 70px}

section{padding:46px 0;border-top:1px solid var(--linha)}
h2{font-size:clamp(26px,4vw,36px);margin:0 0 8px;line-height:1.15}
.lead{color:var(--suave);margin:0 0 28px;max-width:56ch}
.funcoes{display:grid;grid-template-columns:1fr 1fr;gap:26px 44px;margin:0;padding:0;list-style:none}
.funcoes h3{margin:0 0 4px;font-size:18px;color:var(--ambar)}
.funcoes p{margin:0;color:var(--suave);font-size:16px}
.passos{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin:0;padding:0;list-style:none;counter-reset:p}
.passos li{counter-increment:p;padding-top:14px;border-top:3px solid var(--roxo)}
.passos li:before{content:counter(p);font-weight:700;color:var(--roxo2);font-size:22px;display:block}
.passos h3{margin:4px 0;font-size:18px}
.passos p{margin:0;color:var(--suave);font-size:16px}
.planos{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:760px}
.plano{background:var(--painel);border:1px solid var(--linha);border-radius:10px;padding:28px}
.plano.destaque{border:2px solid var(--roxo)}
.plano h3{margin:0;font-size:20px}
.preco{font-size:40px;font-weight:700;margin:8px 0 2px}
.preco small{font-size:16px;color:var(--suave);font-weight:400}
.plano p{color:var(--suave);font-size:15px;margin:0 0 20px;min-height:48px}
.plano .btn{display:block;text-align:center}
.nota{color:var(--suave);font-size:14px;margin-top:18px}
footer{border-top:1px solid var(--linha);padding:30px 0 50px;color:var(--suave);font-size:14px}

@media (max-width:720px){
  .funcoes,.passos,.planos{grid-template-columns:1fr}
  header nav a{margin-left:14px}
  .mesa-topo,.pista{grid-template-columns:84px 1fr}
  .cabeca{left:84px}
  .pista b{font-size:11px;padding:0 8px}
}
@media (prefers-reduced-motion:reduce){.cabeca{animation:none;transform:translateX(30%)}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <a class="logo" href="#"><i>PK</i>PKVS Studio</a>
    <nav><a href="#funcoes">O que faz</a><a href="#planos">Planos</a><a href="#contato">Contato</a></nav>
  </header>

  <h1>Seu VS pronto no REAPER, sem montar track por track.</h1>
  <p class="sub">Escolha a pasta da música e o PKVS Studio importa as faixas, junta por instrumento e deixa tudo em ordem. Depois muda o tom, abaixa o volume e renderiza.</p>
  <div class="btns">
    <a class="btn" href="#planos">Ver planos</a>
    <a class="btn vazio" id="baixar" href="#">Baixar o app</a>
  </div>

  <div class="mesa" aria-label="Exemplo de projeto organizado pelo PKVS Studio">
    <div class="mesa-topo"><div>Projeto</div><div class="musicas" id="musicas"></div></div>
    <div class="pistas" id="pistas"><div class="cabeca"></div></div>
  </div>
  <p class="legenda">Exemplo: três músicas em sequência, cada instrumento na sua track e as tracks iguais agrupadas.</p>
</div>

<section id="funcoes"><div class="wrap">
  <h2>O que ele faz por você</h2>
  <p class="lead">Tudo dentro do REAPER, em um painel que abre quando você clica na bolinha PK.</p>
  <ul class="funcoes">
    <li><h3>Importa a música</h3><p>Aponte a pasta com os áudios (WAV, MP3, FLAC, AIF, OGG, M4A) e ele coloca cada faixa no lugar, com marcador e region.</p></li>
    <li><h3>Organiza por instrumento</h3><p>Bateria e drums ficam na mesma track, baixo e bass também. Click e voz guia ganham a pasta deles.</p></li>
    <li><h3>Muda o tom</h3><p>Digite os semitons e todas as músicas do projeto são transpostas, sem mexer em bateria e click.</p></li>
    <li><h3>Abaixa as tracks</h3><p>Reduz todas as tracks de instrumento por igual para tirar o clipping sem desequilibrar a mixagem.</p></li>
    <li><h3>Renderiza as músicas</h3><p>Exporta cada música em arquivo separado, com o nível nivelado em LUFS.</p></li>
    <li><h3>Reorganiza projetos antigos</h3><p>Um clique une as tracks repetidas de um projeto que você já tinha.</p></li>
  </ul>
</div></section>

<section><div class="wrap">
  <h2>Como começar</h2>
  <p class="lead">Do pagamento ao primeiro VS, sem instalar plugin.</p>
  <ol class="passos">
    <li><h3>Escolha um plano</h3><p>Pague e receba a sua key por e-mail na hora.</p></li>
    <li><h3>Instale</h3><p>Extraia o arquivo e abra o INICIAR. O REAPER abre com a bolinha PK na tela.</p></li>
    <li><h3>Ative</h3><p>Clique na bolinha, cole a key e comece a usar.</p></li>
  </ol>
</div></section>

<section id="planos"><div class="wrap">
  <h2>Planos</h2>
  <p class="lead">Os dois têm todas as funções. A diferença é só o tempo de uso.</p>
  <div class="planos">
    <div class="plano">
      <h3>Mensal</h3>
      <div class="preco"><span id="precoMensal">—</span> <small>/ mês</small></div>
      <p>Uso liberado por 30 dias a partir da ativação da key.</p>
      <a class="btn vazio" id="comprarMensal" href="#">Comprar mensal</a>
    </div>
    <div class="plano destaque">
      <h3>Anual</h3>
      <div class="preco"><span id="precoAnual">—</span> <small>/ ano</small></div>
      <p>Uso liberado por 12 meses a partir da ativação da key.</p>
      <a class="btn" id="comprarAnual" href="#">Comprar anual</a>
    </div>
  </div>
  <p class="nota">Cada key vale para um computador. Pagamento seguro pela plataforma de vendas.</p>
</div></section>

<footer id="contato"><div class="wrap">
  Dúvidas ou suporte: <a id="contatoLink" href="#">fale com a gente</a>.
  <br>PKVS Studio funciona no REAPER para Windows.
</div></footer>

<script>
/* ===== EDITE AQUI: preços, links e contato ===== */
const CONFIG = {
  precoMensal: "",       // ex.: "R$ 29,90"
  precoAnual:  "",       // ex.: "R$ 249,00"
  linkMensal:  "",       // link de compra do plano mensal
  linkAnual:   "",       // link de compra do plano anual
  linkDownload:"",       // link para baixar o app
  contato:     ""        // ex.: "https://wa.me/55DDDNUMERO"
};
/* =============================================== */

const $ = id => document.getElementById(id);
function ligar(id, url, rotulo){
  const el = $(id);
  if(url){ el.href = url; }
  else { el.setAttribute("aria-disabled","true"); if(rotulo) el.textContent = rotulo; }
}
$("precoMensal").textContent = CONFIG.precoMensal || "Em breve";
$("precoAnual").textContent  = CONFIG.precoAnual  || "Em breve";
ligar("comprarMensal", CONFIG.linkMensal, "Em breve");
ligar("comprarAnual",  CONFIG.linkAnual,  "Em breve");
ligar("baixar", CONFIG.linkDownload, "Download em breve");
if(CONFIG.contato) $("contatoLink").href = CONFIG.contato; else $("contatoLink").removeAttribute("href");

/* exemplo visual do projeto */
const pistas = [
  ["Click / guia","#ebc83c"],["Bateria","#dc4646"],["Percussão","#e6823c"],["Baixo","#965ac8"],
  ["Guitarras","#468cdc"],["Teclados","#3cbeaa"],["Metais","#c8a03c"],["Vocais","#f06eaa"],["Loops","#6ec85a"]
];
const musicas = [[0,31,"Música 1"],[34,31,"Música 2"],[68,31,"Música 3"]];
const cheio = [ // quais pistas tocam em cada música (varia para parecer real)
  [1,1,1,1,1,1,0,1,1],[1,1,0,1,1,1,1,1,0],[1,1,1,1,0,1,1,1,1]
];
$("musicas").innerHTML = musicas.map(m=>`<span style="left:${m[0]}%">${m[2]}</span>`).join("");
const box = $("pistas");
pistas.forEach((p,i)=>{
  const linha = document.createElement("div");
  linha.className = "pista"; linha.style.setProperty("--c",p[1]);
  linha.innerHTML = `<b>${p[0]}</b><div class="faixa">${
    musicas.map((m,k)=> cheio[k][i] ? `<i style="left:${m[0]}%;width:${m[1]}%"></i>` : "").join("")}</div>`;
  box.appendChild(linha);
});
const cab = box.querySelector(".cabeca");
function medir(){ const f = box.querySelector(".faixa"); if(f) cab.style.setProperty("--larg", f.offsetWidth+"px"); }
medir(); addEventListener("resize", medir);
</script>
</body>
</html>
